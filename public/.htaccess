<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Après une mise à jour, les fichiers de /assets changent de nom (leur empreinte est
# calculée sur le contenu) mais index.html garde le même. Tant qu'un navigateur le
# gardait en cache, il continuait à charger l'ancienne interface : il doit être
# revérifié à chaque visite, et les fichiers empreintés peuvent être gardés un an.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-store, max-age=0"
  </FilesMatch>

  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/" kithrm_hashed
    <FilesMatch "\.(js|css)$">
      Header set Cache-Control "public, max-age=31536000, immutable" env=kithrm_hashed
    </FilesMatch>
  </IfModule>
</IfModule>
